# ---- Cloudflare (deploy / D1) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Collector -> Worker ingest ----
# Worker の URL (例: https://intel-hub.<subdomain>.workers.dev)
INTEL_HUB_INGEST_URL=
# Worker 側 `wrangler secret put INGEST_TOKEN` と同じ値
INTEL_HUB_INGEST_TOKEN=

# ---- Optional API keys (無い場合は該当collectorをスキップ) ----
# https://github.com/settings/tokens (public_repo の read で十分)
GITHUB_TOKEN=
# https://console.cloud.google.com/ (YouTube Data API v3)
YOUTUBE_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- SEC EDGAR は API キー不要だが User-Agent に連絡先が必須 ----
SEC_EDGAR_USER_AGENT="intel-hub personal research you@example.com"
